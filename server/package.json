{
  "name": "campusguard-server",
  "version": "1.0.0",
  "description": "CampusGuard cloud server for receiving and serving security alerts",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run build:dashboard",
    "build:dashboard": "if [ -d \"../windows-app\" ]; then (cd ../windows-app && npm run build:web); else echo \"⚠️ Skipping dashboard build (Context: Subdirectory)\"; fi",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/pino": "^7.0.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
